<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LucidFlex $50K Paper Trading Battle Pass</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
        .cozy-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            transition: all 0.2s ease;
        }
        .cozy-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
        }
        .tab-btn.active {
            background-color: #0f172a;
            color: #ffffff;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col pb-12">

    <!-- HEADER / NAVIGATION -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-rose-400 to-indigo-500 flex items-center justify-center text-white text-xl font-black shadow-md">
                    ✨
                </div>
                <div>
                    <h1 class="font-extrabold text-base sm:text-lg text-slate-900 leading-tight">LucidFlex $50K Paper Trading</h1>
                    <p class="text-xs text-slate-500 font-medium">Battle Pass & Learning Companion</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button onclick="openExchangeModal()" class="px-3 py-1.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-700 text-xs font-bold border border-stone-200 transition">
                    💱 NZD FX: $<span id="lblFxRate">1.70</span>
                </button>
                <button onclick="toggleBeginnerMode()" id="btnBeginnerToggle" class="px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold border border-indigo-200 transition">
                    🎀 Beginner Mode: ON
                </button>
            </div>
        </div>

        <!-- NAV TABS -->
        <div class="max-w-6xl mx-auto px-4 flex gap-2 overflow-x-auto py-2 scrollbar-none">
            <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap">📊 Dashboard & Setup</button>
            <button onclick="switchTab('career')" id="tab-career" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-stone-100 text-slate-600 transition whitespace-nowrap">🏆 Career Runs</button>
            <button onclick="switchTab('rules')" id="tab-rules" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-stone-100 text-slate-600 transition whitespace-nowrap">🛡️ My Trading Rules</button>
            <button onclick="switchTab('dictionary')" id="tab-dictionary" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-stone-100 text-slate-600 transition whitespace-nowrap">📖 Trading Dictionary</button>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINERS -->
    <main class="max-w-6xl mx-auto px-4 mt-6 flex-grow w-full space-y-6">

        <!-- DASHBOARD TAB -->
        <section id="sec-dashboard" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="cozy-card p-5 space-y-2">
                    <span class="text-slate-500 text-xs font-semibold">Account Target</span>
                    <div class="text-2xl font-black text-slate-900">$50,000.00 <span class="text-xs font-semibold text-slate-500">USD</span></div>
                    <div class="text-xs text-slate-600 font-medium">Approx. <strong class="text-slate-800" id="valNzdTarget">$85,000 NZD</strong></div>
                </div>
                <div class="cozy-card p-5 space-y-2">
                    <span class="text-slate-500 text-xs font-semibold">Current Simulated Equity</span>
                    <input type="number" id="inputCurrentBalance" onchange="updateAccountBalance()" class="w-full text-2xl font-black text-slate-900 border-b border-slate-300 focus:border-indigo-500 focus:outline-none bg-transparent" value="50000" step="50">
                    <div class="text-xs text-slate-600 font-medium">Approx. <strong class="text-slate-800" id="valNzdCurrent">$85,000 NZD</strong></div>
                </div>
                <div class="cozy-card p-5 space-y-2">
                    <span class="text-slate-500 text-xs font-semibold">Current Account Status</span>
                    <div id="statusBadge" class="text-lg font-extrabold text-emerald-600 flex items-center gap-2">
                        <span>🟢</span> On Track
                    </div>
                    <p class="text-xs text-slate-500 font-medium">Keep max risk under 1-2% per trade setup.</p>
                </div>
            </div>

            <div class="cozy-card p-6 space-y-4">
                <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <span>⚡</span> Quick Trade Setup Assistant
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Asset</label>
                        <select id="calcAsset" class="w-full p-2.5 rounded-xl border border-slate-200 text-xs font-bold bg-stone-50">
                            <option value="GOLD">Gold (XAU/USD)</option>
                            <option value="OIL">Crude Oil (WTI)</option>
                            <option value="EURUSD">EUR/USD</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Risk Capital (%)</label>
                        <input type="number" id="calcRiskPct" value="1" min="0.1" max="5" step="0.1" class="w-full p-2.5 rounded-xl border border-slate-200 text-xs font-bold bg-stone-50">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Stop Loss Distance (Pips/Ticks)</label>
                        <input type="number" id="calcSlDistance" value="30" class="w-full p-2.5 rounded-xl border border-slate-200 text-xs font-bold bg-stone-50">
                    </div>
                </div>
                <div class="bg-stone-50 p-4 rounded-2xl border border-stone-200 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-slate-700">
                    <div>Max Allowable Loss: <span id="calcMaxLossVal" class="text-rose-600 font-extrabold">$500.00 USD</span></div>
                    <div>Suggested Lot Size: <span id="calcLotSizeVal" class="text-indigo-600 font-extrabold">0.16 Lots</span></div>
                    <button onclick="calculateTradeRisk()" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white transition">Calculate Position</button>
                </div>
            </div>
        </section>

        <!-- CAREER RUNS TAB -->
        <section id="sec-career" class="space-y-6 hidden">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-extrabold text-slate-900">Career Runs & Challenge History</h2>
                    <p class="text-xs text-slate-500 font-medium">Log your paper trading accounts to monitor long-term consistency.</p>
                </div>
                <button onclick="addNewCareerRun()" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition shadow-sm">
                    + Log New Run
                </button>
            </div>

            <div id="careerRunsContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Rendered Dynamically -->
            </div>
        </section>

        <!-- RULES TAB -->
        <section id="sec-rules" class="space-y-6 hidden">
            <div class="cozy-card p-6 space-y-4">
                <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <span>🛡️</span> Risk Management & Trading Checklist
                </h2>
                <div class="flex gap-2">
                    <input type="text" id="newRuleText" placeholder="e.g., Never trade 15 minutes before high-impact news..." class="flex-grow p-2.5 rounded-xl border border-slate-200 text-xs font-medium focus:outline-none">
                    <button onclick="addPersonalRule()" class="px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition">Add Rule</button>
                </div>
                <div id="rulesContainer" class="space-y-2">
                    <!-- Rendered Dynamically -->
                </div>
            </div>
        </section>

        <!-- DICTIONARY TAB -->
        <section id="sec-dictionary" class="space-y-6 hidden">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-extrabold text-slate-900">Trading Dictionary</h2>
                    <p class="text-xs text-slate-500 font-medium">Plain-English definitions with clear practical examples.</p>
                </div>
                <input type="text" id="dictSearch" oninput="renderDictionary()" placeholder="Search terms (e.g. Stop Loss, Spread)..." class="p-2.5 rounded-xl border border-slate-200 text-xs font-medium w-full sm:w-64 focus:outline-none">
            </div>

            <div id="dictionaryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Rendered Dynamically -->
            </div>
        </section>

    </main>

    <!-- EXCHANGE RATE MODAL -->
    <div id="modalFx" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="cozy-card p-6 max-w-sm w-full mx-4 space-y-4">
            <h3 class="text-sm font-extrabold text-slate-900">Update USD/NZD Exchange Rate</h3>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">1 USD = ? NZD</label>
                <input type="number" id="inputFxRate" step="0.01" class="w-full p-2.5 rounded-xl border border-slate-200 text-xs font-bold bg-stone-50">
            </div>
            <div class="flex gap-2 justify-end">
                <button onclick="closeExchangeModal()" class="px-3 py-2 rounded-xl bg-stone-100 text-slate-600 text-xs font-bold">Cancel</button>
                <button onclick="saveExchangeRate()" class="px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold">Save Rate</button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION FLOATER -->
    <div id="toast" class="fixed bottom-4 right-4 bg-slate-900/90 backdrop-blur-md text-white text-xs font-bold px-4 py-3 rounded-2xl shadow-xl z-50 hidden transition-all border border-slate-700 max-w-sm"></div>

    <script>
        // APP STATE
        let appState = {
            exchangeRate: 1.70,
            beginnerMode: true,
            currentBalance: 50000,
            careerRuns: [
                { id: 1, runNumber: 1, finalBalance: 51200, totalTrades: 14, status: 'PASSED', notes: 'First successful run using strict stop losses on Gold.' }
            ],
            personalRules: [
                { id: 101, text: "Always place Stop Loss immediately when entering a trade.", isLucid: true },
                { id: 102, text: "Risk maximum 1% to 2% of total account per position.", isLucid: true },
                { id: 103, text: "Avoid opening trades during high-impact news releases.", isLucid: false }
            ]
        };

        // EXPANDED DICTIONARY DATA
        const DICTIONARY_DATA = [
            { term: "Paper Trading", category: "Basics", icon: "📝", simple: "Simulated trading using fake money to practice strategy without financial risk.", why: "Lets you test entry setups, emotion control, and risk management safely.", example: "Practicing a sell short order on Gold using a $50,000 demo balance." },
            { term: "Lot Size", category: "Forex & Commodities", icon: "📦", simple: "The standardized unit size of a trade position.", why: "Determines how much profit or loss you make for every price movement.", example: "Trading 0.01 lots (micro lot) instead of 1.0 lot to keep risk minimal." },
            { term: "Pip / Tick", category: "Price Movement", icon: "📏", simple: "The smallest standard price change made by a given asset.", why: "Used to calculate profit, loss, and stop-loss distance accurately.", example: "Gold moving from 2,650.00 to 2,650.10 is a 10-tick movement." },
            { term: "Spread", category: "Brokerage", icon: "↔️", simple: "The difference between the buying price (Ask) and selling price (Bid).", why: "It is the fee paid to the broker upon entering any market order.", example: "If Bid is $2,650.00 and Ask is $2,650.30, the spread cost is $0.30 per unit." },
            { term: "Stop Loss (SL)", category: "Risk Control", icon: "🛡️", simple: "An automated order that closes your trade if the price goes too far against you.", why: "Prevents account blowouts by capping maximum loss on a single trade.", example: "Setting SL $5 below entry so you only risk 1% of your account." },
            { term: "Take Profit (TP)", category: "Risk Control", icon: "🎯", simple: "An automated order that closes your trade once a target profit level is hit.", why: "Locks in profits automatically without needing to watch the screen constantly.", example: "Setting TP at key resistance level to lock in a 2:1 reward target." },
            { term: "Risk-to-Reward (R:R)", category: "Strategy", icon: "⚖️", simple: "The ratio comparing potential loss against expected potential profit.", why: "Helps you stay profitable even if you lose half of your total trades.", example: "A 1:2 R:R means risking $20 to make $40 on a successful trade." },
            { term: "Support & Resistance", category: "Technical Analysis", icon: "📊", simple: "Price levels where price historically pauses, bounces, or reverses.", why: "Highlights logical points to place trade entries, stop losses, and take profits.", example: "Buying near a price floor that bounced three times in the past week." },
            { term: "Breakout", category: "Technical Analysis", icon: "💥", simple: "When price moves beyond a strong support or resistance level with momentum.", why: "Signals that a new directional trend may be starting.", example: "Entering a buy trade after Crude Oil breaks above a $75 resistance level." },
            { term: "Liquidity", category: "Market Structure", icon: "💧", simple: "How easily an asset can be bought or sold without causing a huge price swing.", why: "High liquidity ensures fast trade execution at predictable prices.", example: "Gold (XAU/USD) has high liquidity compared to low-cap crypto tokens." },
            { term: "Leverage", category: "Margin", icon: "🔍", simple: "Borrowed capital from a broker to open larger positions with less cash upfront.", why: "Amplifies gains significantly, but multiplies potential losses just as quickly.", example: "Using 1:100 leverage lets a $100 margin control a $10,000 trade position." },
            { term: "Margin Call", category: "Margin", icon: "⚠️", simple: "A warning that account funds have fallen below the required level to keep trades open.", why: "If ignored, the broker will automatically liquidate open positions at a loss.", example: "Over-leveraging without a stop loss triggering an auto-close of all positions." },
            { term: "Bearish vs. Bullish", category: "Market Direction", icon: "🐂", simple: "Bullish means expecting prices to rise; Bearish means expecting prices to fall.", why: "Guides whether you should look for buy (long) or sell (short) trade entries.", example: "A bullish setup targets higher price highs; a bearish setup shorts lower lows." },
            { term: "Long vs. Short", category: "Basics", icon: "🔄", simple: "Long means buying to profit from price increases; Short means selling to profit from declines.", why: "Allows profit opportunities in both rising and falling markets.", example: "Shorting WTI Oil at $78 expecting price to fall toward $72." },
            { term: "Slippage", category: "Brokerage", icon: "📉", simple: "The difference between expected trade entry price and actual execution price.", why: "Occurs during fast market moves, high-impact news releases, or low liquidity.", example: "Ordering a buy at $2,650.00 but getting filled at $2,650.80 during a news spike." },
            { term: "Candlestick Wick", category: "Technical Analysis", icon: "🕯️", simple: "The thin line extending above or below a candle showing extreme high/low prices.", why: "Long wicks signal price rejection and potential market reversal.", example: "A long bottom wick on a candle shows buyers pushed price back up strong." },
            { term: "Moving Average (MA)", category: "Indicators", icon: "📈", simple: "An indicator that smooths out price data to show the overall trend direction.", why: "Helps identify trend direction without getting distracted by short-term noise.", example: "Price staying above the 200 EMA indicates an overall long-term uptrend." },
            { term: "Relative Strength Index (RSI)", category: "Indicators", icon: "⚡", simple: "A momentum indicator measuring if an asset is overbought or oversold (0 to 100).", why: "Warns when price might be overextended and ready for a pullback.", example: "RSI rising above 70 indicates potential overbought conditions." },
            { term: "FOMO (Fear Of Missing Out)", category: "Psychology", icon: "🧠", simple: "Entering a trade impulsively because price is moving fast without waiting for a setup.", why: "Leading cause of buying at market tops or shorting at market bottoms.", example: "Chasing a fast green candle upward instead of waiting for a retest setup." },
            { term: "Revenge Trading", category: "Psychology", icon: "🔥", simple: "Immediately opening aggressive trades to recoup money lost on a previous bad trade.", why: "Breaks trading rules and leads to compounding, catastrophic account losses.", example: "Doubling position size right after losing a trade to try to 'get it back'." },
            { term: "Risk per Trade", category: "Risk Control", icon: "🛡️", simple: "The exact dollar or percentage amount lost if a trade hits its stop loss.", why: "Ensures survival over long loss streaks by keeping risk per trade consistent.", example: "Limiting maximum loss to 1% ($500 on a $50,000 paper trading account)." },
            { term: "Drawdown", category: "Performance", icon: "📉", simple: "The peak-to-trough decline in your trading account balance.", why: "Measures overall account risk and strategy stability over time.", example: "Account dropping from $50,000 to $47,000 represents a 6% drawdown." },
            { term: "Limit Order vs. Market Order", category: "Orders", icon: "⚡", simple: "Market Order executes immediately at current price; Limit Order executes at a specified future price.", why: "Limit orders save spread costs and ensure exact price execution targets.", example: "Placing a Buy Limit at $2,640.00 to enter only if price dips to that exact key level." },
            { term: "Trailing Stop", category: "Risk Control", icon: "🎰", simple: "A stop loss that automatically adjusts upward/downward as trade profit increases.", why: "Protects profits while allowing winning trades room to continue running.", example: "Trailing SL by $2 behind price to guarantee locked-in gain as Gold rises." },
            { term: "Consolidation", category: "Technical Analysis", icon: "↔️", simple: "Price moving sideways within a tight range without clear trend direction.", why: "Signals market indecision before a major breakout occurs.", example: "Oil moving sideways between $74.00 and $74.50 for hours before a big move." }
        ];

        // INITIALIZATION
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedState();
            renderAll();
        });

        function saveState() {
            localStorage.setItem('lucidflex_app_state', JSON.stringify(appState));
            renderAll();
        }

        function loadSavedState() {
            const saved = localStorage.getItem('lucidflex_app_state');
            if (saved) {
                try {
                    appState = { ...appState, ...JSON.parse(saved) };
                } catch (e) {
                    console.error("Failed to parse saved state", e);
                }
            }
        }

        function renderAll() {
            document.getElementById('lblFxRate').innerText = appState.exchangeRate.toFixed(2);
            document.getElementById('btnBeginnerToggle').innerText = `🎀 Beginner Mode: ${appState.beginnerMode ? 'ON' : 'OFF'}`;
            
            document.getElementById('valNzdTarget').innerText = `$${(50000 * appState.exchangeRate).toLocaleString()} NZD`;
            document.getElementById('valNzdCurrent').innerText = `$${(appState.currentBalance * appState.exchangeRate).toLocaleString()} NZD`;
            document.getElementById('inputCurrentBalance').value = appState.currentBalance;

            renderCareerRuns();
            renderRulesList();
            renderDictionary();
            calculateTradeRisk();
        }

        // TAB SWITCHING
        function switchTab(tabId) {
            ['dashboard', 'career', 'rules', 'dictionary'].forEach(t => {
                document.getElementById(`sec-${t}`).classList.add('hidden');
                const btn = document.getElementById(`tab-${t}`);
                btn.classList.remove('active');
                btn.classList.add('bg-stone-100', 'text-slate-600');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('active');
            activeBtn.classList.remove('bg-stone-100', 'text-slate-600');
        }

        // ACCOUNT LOGIC
        function updateAccountBalance() {
            const val = parseFloat(document.getElementById('inputCurrentBalance').value) || 0;
            appState.currentBalance = val;
            saveState();
        }

        function calculateTradeRisk() {
            const balance = appState.currentBalance;
            const riskPct = parseFloat(document.getElementById('calcRiskPct').value) || 1;
            const slDistance = parseFloat(document.getElementById('calcSlDistance').value) || 30;

            const maxLoss = (balance * (riskPct / 100));
            const estimatedLot = (maxLoss / (slDistance * 10)).toFixed(2);

            document.getElementById('calcMaxLossVal').innerText = `$${maxLoss.toFixed(2)} USD`;
            document.getElementById('calcLotSizeVal').innerText = `${Math.max(0.01, estimatedLot)} Lots`;
        }

        // CAREER RUNS MANAGEMENT
        function renderCareerRuns() {
            const container = document.getElementById('careerRunsContainer');
            if (!container) return;

            const runs = appState.careerRuns || [];

            if (runs.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-8 text-xs font-semibold text-slate-500">
                        No career runs logged yet. Start a new run to track your $50K challenge progress!
                    </div>`;
                return;
            }

            let html = '';
            runs.forEach(run => {
                const isPassed = run.status === 'PASSED';
                const statusBadge = isPassed 
                    ? `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200">PASSED</span>`
                    : `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-200">FAILED</span>`;

                html += `
                    <div class="cozy-card p-4 space-y-3 relative group">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-800 text-sm">Run #${run.runNumber || run.id}</span>
                                ${statusBadge}
                            </div>
                            
                            <!-- DELETE RUN BUTTON -->
                            <button 
                                onclick="deleteRun(${run.id})" 
                                aria-label="Delete run" 
                                class="text-slate-400 hover:text-rose-500 text-xs font-bold px-2 py-1 rounded-lg hover:bg-rose-50 transition-colors"
                            >
                                🗑️ Delete
                            </button>
                        </div>

                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div class="bg-stone-50 p-2 rounded-xl border border-stone-100">
                                <span class="text-slate-500 text-[10px] block font-medium">Final Balance</span>
                                <strong class="text-slate-800 font-bold">$${(run.finalBalance || 0).toLocaleString()} USD</strong>
                            </div>
                            <div class="bg-stone-50 p-2 rounded-xl border border-stone-100">
                                <span class="text-slate-500 text-[10px] block font-medium">Trades Logged</span>
                                <strong class="text-slate-800 font-bold">${run.totalTrades || 0}</strong>
                            </div>
                        </div>

                        ${run.notes ? `<p class="text-[11px] text-slate-600 italic bg-stone-50/60 p-2 rounded-lg border border-stone-100">"${run.notes}"</p>` : ''}
                    </div>`;
            });

            container.innerHTML = html;
        }

        function addNewCareerRun() {
            const nextNum = (appState.careerRuns.length > 0) ? appState.careerRuns[appState.careerRuns.length - 1].runNumber + 1 : 1;
            const newRun = {
                id: Date.now(),
                runNumber: nextNum,
                finalBalance: appState.currentBalance,
                totalTrades: 0,
                status: appState.currentBalance >= 50000 ? 'PASSED' : 'FAILED',
                notes: 'Active paper trading run.'
            };

            appState.careerRuns.push(newRun);
            saveState();
            showToast("New career run logged successfully!");
        }

        function deleteRun(runId) {
            if (!confirm("Are you sure you want to delete this career run?")) return;

            appState.careerRuns = appState.careerRuns.filter(run => run.id !== runId);
            saveState();
            showToast("Run deleted successfully!");
        }

        // DICTIONARY RENDER
        function renderDictionary() {
            const grid = document.getElementById('dictionaryGrid');
            const searchVal = (document.getElementById('dictSearch')?.value || '').toLowerCase();

            const filtered = DICTIONARY_DATA.filter(item => 
                item.term.toLowerCase().includes(searchVal) ||
                item.simple.toLowerCase().includes(searchVal) ||
                item.category.toLowerCase().includes(searchVal)
            );

            let html = '';
            filtered.forEach(item => {
                html += `
                    <div class="cozy-card p-4 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                                <span>${item.icon}</span> ${item.term}
                            </span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-100 text-slate-600 border border-stone-200">${item.category}</span>
                        </div>
                        <p class="text-xs font-semibold text-slate-700">${item.simple}</p>
                        <div class="bg-stone-50/80 p-2 rounded-xl text-[11px] text-slate-600 space-y-1 border border-stone-100">
                            <p><strong class="text-slate-700">Why it matters:</strong> ${item.why}</p>
                            <p><strong class="text-slate-700">Example:</strong> ${item.example}</p>
                        </div>
                    </div>`;
            });

            if (filtered.length === 0) {
                html = `<div class="col-span-full text-center py-8 text-xs font-semibold text-slate-500">No matching dictionary terms found.</div>`;
            }

            grid.innerHTML = html;
        }

        // RULES RENDER & ACTIONS
        function renderRulesList() {
            const container = document.getElementById('rulesContainer');
            const rules = appState.personalRules || [];

            let html = '';
            rules.forEach(rule => {
                html += `
                    <div class="cozy-card p-3.5 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5 text-xs font-semibold text-slate-800">
                            <span class="${rule.isLucid ? 'text-rose-500' : 'text-indigo-500'} font-bold text-sm">${rule.isLucid ? '🩷' : '🎀'}</span>
                            <span>${rule.text}</span>
                        </div>
                        ${!rule.isLucid ? `<button onclick="deletePersonalRule(${rule.id})" aria-label="Delete rule" class="text-rose-400 hover:text-rose-600 text-xs font-bold px-2 py-1">Delete</button>` : `<span class="text-[10px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">Lucid Rule</span>`}
                    </div>`;
            });

            container.innerHTML = html;
        }

        function addPersonalRule() {
            const textInput = document.getElementById('newRuleText');
            const val = textInput.value.trim();
            if (!val) return;

            appState.personalRules.push({
                id: Date.now(),
                text: val,
                isLucid: false
            });

            textInput.value = '';
            saveState();
        }

        function deletePersonalRule(ruleId) {
            appState.personalRules = appState.personalRules.filter(r => r.id !== ruleId);
            saveState();
        }

        // MODAL & UTILS
        function toggleBeginnerMode() {
            appState.beginnerMode = !appState.beginnerMode;
            saveState();
        }

        function openExchangeModal() {
            document.getElementById('inputFxRate').value = appState.exchangeRate.toFixed(2);
            document.getElementById('modalFx').classList.remove('hidden');
        }

        function closeExchangeModal() {
            document.getElementById('modalFx').classList.add('hidden');
        }

        function saveExchangeRate() {
            const rate = parseFloat(document.getElementById('inputFxRate').value) || 1.70;
            appState.exchangeRate = rate;
            saveState();
            closeExchangeModal();
            showToast("Exchange rate updated!");
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
</html>
